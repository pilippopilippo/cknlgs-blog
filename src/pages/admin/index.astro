---
// Writing panel (Sveltia CMS, https://github.com/sveltia/sveltia-cms) at /admin/: it signs in to
// GitHub and saves posts as commits to the repository, so Cloudflare publishes them like any other
// change. Its settings (fields, image handling...) are in public/admin/config.yml.
//
// The CMS is installed with npm, at a pinned version (see package.json), and served from this site
// instead of a CDN: the page always runs the exact code that was tested.
import sveltiaCms from "../../../node_modules/@sveltia/cms/dist/sveltia-cms.js?url";
import { SITE_TITLE } from "../../consts";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{`${SITE_TITLE} · Admin`}</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link href="/admin/config.yml" type="application/yaml" rel="cms-config-url" />
	</head>
	<body>
		<script is:inline src={sveltiaCms}></script>
	</body>
</html>
