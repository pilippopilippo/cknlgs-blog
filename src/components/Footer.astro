---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer lang="en">
	&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.
</footer>
<style>
	footer {
		padding: 1.5em 1em;
		/* Same color as the page background, in both themes */
		background: var(--bg);
		color: rgb(var(--gray));
		text-align: center;
	}
</style>