---
// Tag buttons that filter the post list on the same page (no reload).
// The selected tag is kept in the URL (?tag=...) so a filtered view can be shared.
import type { Tag } from '../utils/posts';

interface Props {
	tags: Tag[];
}

const { tags } = Astro.props;
---

{
	tags.length > 0 && (
		<nav class="tag-filter" aria-label="Filter posts by tag">
			<ul class="tag-list">
				<li>
					<button type="button" class="tag active" data-tag="" aria-pressed="true">
						All
					</button>
				</li>
				{tags.map((tag) => (
					<li>
						<button type="button" class="tag" data-tag={tag.slug} aria-pressed="false">
							#{tag.label}
							<span class="count">{tag.count}</span>
						</button>
					</li>
				))}
			</ul>
			<a class="all-tags" href="/tags/">
				All tags →
			</a>
		</nav>
	)
}

<script>
	const buttons = [...document.querySelectorAll<HTMLButtonElement>('.tag-filter button[data-tag]')];
	const list = document.querySelector<HTMLUListElement>('ul.post-list');

	function select(slug: string) {
		// Ignore unknown tags (e.g. an old shared link)
		if (!buttons.some((button) => button.dataset.tag === slug)) slug = '';
		for (const button of buttons) {
			const active = button.dataset.tag === slug;
			button.classList.toggle('active', active);
			button.setAttribute('aria-pressed', String(active));
		}
		for (const item of list?.querySelectorAll<HTMLLIElement>(':scope > li') ?? []) {
			item.hidden = slug !== '' && !(item.dataset.tags ?? '').split(' ').includes(slug);
		}
		list?.classList.toggle('filtered', slug !== '');

		const url = new URL(location.href);
		if (slug) url.searchParams.set('tag', slug);
		else url.searchParams.delete('tag');
		history.replaceState(null, '', url);
	}

	for (const button of buttons) {
		button.addEventListener('click', () => select(button.dataset.tag ?? ''));
	}
	// On phones the bar is hidden (see CSS), so a ?tag= link shows the full list instead of
	// a filtered one with no visible way back to "All"
	const barVisible = !matchMedia('(max-width: 720px)').matches;
	const initial = new URLSearchParams(location.search).get('tag');
	if (initial && barVisible) select(initial);
</script>

<style>
	.tag-filter {
		margin-bottom: 2rem;
		text-align: center;
	}
	/* On phones the tag bar is hidden: tags are reachable from "Tags" in the hamburger menu */
	@media (max-width: 720px) {
		.tag-filter {
			display: none;
		}
	}
	.all-tags {
		display: inline-block;
		margin-top: 0.75em;
		font-size: 0.85em;
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.all-tags:hover {
		color: var(--accent);
	}
</style>
