---
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';
import { type Post, postTags } from '../utils/posts';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
---

{posts.length === 0 && <p class="empty">No posts yet.</p>}
<ul class="post-list">
	{
		posts.map((post, i) => {
			const tags = postTags(post);
			return (
				<li data-tags={tags.map((tag) => tag.slug).join(' ')}>
					<a href={`/blog/${post.id}/`}>
						{post.data.heroImage && (
							// The first (featured) post is shown full width
							<Image width={i === 0 ? 960 : 720} src={post.data.heroImage} alt="" />
						)}
						<h4 class="title">{post.data.title}</h4>
						<p class="date">
							<FormattedDate date={post.data.pubDate} />
							{post.data.author && <span> · by {post.data.author}</span>}
						</p>
					</a>
					<TagList tags={tags} />
				</li>
			);
		})
	}
</ul>

<style>
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
		list-style-type: none;
		margin: 0;
		padding: 0;
	}
	ul li {
		width: calc(50% - 1rem);
	}
	ul li :global(.tag-list) {
		justify-content: flex-start;
	}
	ul li[hidden] {
		display: none;
	}
	ul li a {
		display: block;
		text-decoration: none;
		transition: 0.2s ease;
	}
	ul li a * {
		text-decoration: none;
		transition: 0.2s ease;
	}
	/* The newest post is featured full width, unless the list is being filtered */
	ul:not(.filtered) li:first-child {
		width: 100%;
		margin-bottom: 1rem;
		text-align: center;
	}
	ul:not(.filtered) li:first-child :global(.tag-list) {
		justify-content: center;
	}
	ul:not(.filtered) li:first-child img {
		width: 100%;
	}
	ul:not(.filtered) li:first-child .title {
		font-size: 1.953em;
	}
	ul li img {
		margin-bottom: 0.5rem;
		border-radius: 12px;
	}
	.title {
		margin: 0;
		color: rgb(var(--black));
		line-height: 1.2;
	}
	.date {
		margin: 0;
		color: rgb(var(--gray));
	}
	ul li a:hover h4,
	ul li a:hover .date {
		color: rgb(var(--accent));
	}
	ul a:hover img {
		box-shadow: var(--box-shadow);
	}
	.empty {
		text-align: center;
		color: rgb(var(--gray));
	}
	@media (max-width: 720px) {
		ul {
			gap: 2em;
		}
		ul li {
			width: 100%;
			text-align: center;
		}
		ul li :global(.tag-list) {
			justify-content: center;
		}
		ul:not(.filtered) li:first-child {
			margin-bottom: 0;
		}
		ul:not(.filtered) li:first-child .title {
			font-size: 1.4em;
		}
	}
</style>
