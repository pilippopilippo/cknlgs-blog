---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PostEnhancements from '../components/PostEnhancements.astro';
import TagList from '../components/TagList.astro';
import { tagSlug } from '../utils/posts';
import { SITE_DESCRIPTION } from '../consts';

type PostData = CollectionEntry<'blog'>['data'];
// Date and description are optional so standalone pages (e.g. About) can use this layout too
type Props = Omit<PostData, 'draft' | 'pubDate' | 'description' | 'tags'> &
	Partial<Pick<PostData, 'pubDate' | 'description' | 'tags'>>;

const {
	title,
	description = SITE_DESCRIPTION,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	author,
} = Astro.props;
const tagLinks = [...new Map(tags.map((label) => [tagSlug(label), label])).entries()]
	.filter(([slug]) => slug)
	.map(([slug, label]) => ({ slug, label }));
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} author={author} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
				line-height: 1.15;
			}
			/*
			  Comfortable line length: text stops at 36rem / 576px (about 72-75 characters per line,
			  within the recommended 50-75); images keep the full column width (720px).
			*/
			.prose > :global(*:not(.title, p:has(> img))) {
				/* rem, not em: headings have a larger font-size and would get a wider measure */
				max-width: 36rem;
				/* Include list indentation in the width so lists line up with paragraphs */
				box-sizing: border-box;
				margin-left: auto;
				margin-right: auto;
			}
			@media (max-width: 720px) {
				/* Smaller side margins on phones: ~18px instead of ~36px */
				.prose {
					max-width: 100%;
					padding: 1em 0;
				}
			}
			.title :global(.tag-list) {
				margin-bottom: 1em;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						{
							pubDate && (
								<div class="date">
									<FormattedDate date={pubDate} />
									{author && <span class="author"> · by {author}</span>}
									{updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)}
								</div>
							)
						}
						<h1>{title}</h1>
						<TagList tags={tagLinks} />
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
		<PostEnhancements />
	</body>
</html>
